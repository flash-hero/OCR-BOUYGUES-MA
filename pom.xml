<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.bycn.edoc</groupId>
    <artifactId>edoc-ocr</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>eDoc OCR</name>
    <description>Moteur OCR pour eDoc — ÉA1 : détection et extraction générique de cartouche via Mistral OCR</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <pdfbox.version>3.0.3</pdfbox.version>
        <fuzzywuzzy.version>1.4.0</fuzzywuzzy.version>
    </properties>

    <dependencies>
        <!-- Framework web + Jackson (JSON) + SnakeYAML (config) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Lecture des PDF (nombre de pages, dimensions) — l'appel OCR envoie le PDF brut en base64 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- Correspondance floue libelle lu <-> synonyme (P3 classification). Regle non negociable :
             jamais d'egalite stricte, le corpus contient des variantes ("NUM", "LEVEL"...). -->
        <dependency>
            <groupId>me.xdrop</groupId>
            <artifactId>fuzzywuzzy</artifactId>
            <version>${fuzzywuzzy.version}</version>
        </dependency>

        <!-- Tests : JUnit 5 + Mockito + AssertJ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
