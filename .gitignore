data/samples/*.pdf
!data/samples/.gitkeep

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
